<div id="<%= dom_id post %>" class="w-full sm:w-auto my-5 space-y-5">
    <h2 class="text-xl font-bold"><%= post.title %></h2>
    <p class="text-gray-600"><%= post.content %></p>
    <p class="text-sm text-gray-500">By <%= post.author %></p>
    <p class="text-lg font-semibold">${{post.likes}}</p>
    <div class="flex space-x-2">
        <div class="bg-blue-500 text-white px-3 py-1 rounded cursor-pointer hover:bg-blue-600">
            comments: <%= post.comments %>  
        </div>
        <div class="bg-green-500 text-white px-3 py-1 rounded cursor-pointer hover:bg-green-600">
            Content: <%= post.content %>
        </div>
    </div>
</div>
